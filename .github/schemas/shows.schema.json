{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/rundfunkarr/schemas/shows.schema.json",
  "title": "Shows Data",
  "description": "Schema for shows.json - TVDB show data with episodes",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["tvdbId", "name", "germanName", "aliases", "episodes"],
    "additionalProperties": false,
    "properties": {
      "tvdbId": {
        "type": "integer",
        "description": "TVDB ID of the show",
        "minimum": 1
      },
      "name": {
        "type": "string",
        "description": "Original name of the show",
        "minLength": 1
      },
      "germanName": {
        "type": ["string", "null"],
        "description": "German name of the show"
      },
      "aliases": {
        "type": "array",
        "description": "Alternative names for the show",
        "items": {
          "type": "string"
        }
      },
      "mediathekProgrammes": {
        "type": "array",
        "description": "Explicit standard-programme bindings; publisher and canonical coordinates remain distinct",
        "maxItems": 100,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["website", "source", "target"],
          "properties": {
            "website": {
              "type": "string",
              "format": "uri",
              "maxLength": 2048,
              "pattern": "^https://[^?#]+$"
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": ["channel", "title", "season", "episode"],
              "properties": {
                "channel": { "type": "string", "minLength": 1, "maxLength": 100 },
                "title": { "type": "string", "minLength": 1, "maxLength": 500 },
                "season": { "type": "integer", "minimum": 0, "maximum": 10000 },
                "episode": { "type": "integer", "minimum": 1, "maximum": 100000 }
              }
            },
            "target": {
              "type": "object",
              "additionalProperties": false,
              "required": ["season", "episode"],
              "properties": {
                "season": { "type": "integer", "minimum": 0, "maximum": 10000 },
                "episode": { "type": "integer", "minimum": 1, "maximum": 100000 }
              }
            }
          }
        }
      },
      "episodes": {
        "type": "array",
        "description": "List of episodes",
        "items": {
          "type": "object",
          "required": ["name", "seasonNumber", "episodeNumber", "aired"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "description": "Episode name"
            },
            "seasonNumber": {
              "type": "integer",
              "description": "Season number",
              "minimum": 0
            },
            "episodeNumber": {
              "type": "integer",
              "description": "Episode number within the season",
              "minimum": 0
            },
            "aired": {
              "type": ["string", "null"],
              "description": "Air date in ISO format (YYYY-MM-DD)",
              "format": "date"
            },
            "runtime": {
              "type": ["number", "null"],
              "description": "Expected episode runtime in minutes; absent or null means unknown",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
