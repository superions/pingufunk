# Both backends are supported; without PostgreSQL configuration use SQLite.
# Relative file paths retain their historical base: prisma/.
# Optional assertion, not required: DATABASE_PROVIDER=sqlite or postgresql.
DATABASE_URL="file:./data/rundfunkarr.db"
# To use PostgreSQL, remove
# the SQLite URL. Provide DATABASE_URL in an ignored local .env file or use
# DATABASE_URL_FILE with a mounted, non-symlink secret. Never commit a PG URL.
# DATABASE_URL_FILE=/run/secrets/pingufunk_database_url
DOWNLOAD_FOLDER_PATH="/downloads"

# Optional metadata credentials: mount files outside the repository and set
# these environment variable names to their absolute paths. Never commit the
# file contents or put credentials in URLs, browser forms, or this example.
# PINGUFUNK_TVDB_KEY_FILE=/run/secrets/pingufunk_tvdb_key
# PINGUFUNK_TVDB_PIN_FILE=/run/secrets/pingufunk_tvdb_pin
# PINGUFUNK_TMDB_READ_TOKEN_FILE=/run/secrets/pingufunk_tmdb_read_token
# PINGUFUNK_SRGSSR_CONSUMER_KEY_FILE=/run/secrets/pingufunk_srgssr_key
# PINGUFUNK_SRGSSR_CONSUMER_SECRET_FILE=/run/secrets/pingufunk_srgssr_secret
# PINGUFUNK_STREAMING_PROXY_URL_FILE=/run/secrets/pingufunk_streaming_proxy_url
