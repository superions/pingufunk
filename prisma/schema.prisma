generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TvdbSeries {
  id         Int           @id
  name       String
  germanName String?
  slug       String?
  overview   String?
  aliases    String? // JSON array stored as string
  firstAired DateTime?     @db.Timestamptz(3)
  cachedAt   DateTime      @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime      @db.Timestamptz(3)
  episodes   TvdbEpisode[]
}

model TvdbEpisode {
  id            Int        @id @default(autoincrement())
  seriesId      Int
  seasonNumber  Int
  episodeNumber Int
  name          String?
  aired         DateTime?  @db.Timestamptz(3)
  runtime       Int?
  series        TvdbSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([seriesId, seasonNumber, episodeNumber])
}

model Download {
  id              String    @id @default(uuid())
  title           String
  url             String
  category        String
  status          String    @default("queued")
  progress        Int       @default(0)
  size            BigInt    @default(0)
  totalSize       BigInt    @default(0)
  downloadedBytes BigInt    @default(0)
  speed           BigInt    @default(0)
  filePath        String?
  error           String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  completedAt     DateTime? @db.Timestamptz(3)

  @@index([status])
}

model Config {
  key   String @id
  value String
}

model GeneratedRuleset {
  id               String   @id @default(uuid())
  topic            String   @unique // MediathekView topic
  tvdbId           Int
  showName         String
  germanName       String?
  matchingStrategy String   @default("SeasonAndEpisodeNumber")
  filters          String   @default("[{\"attribute\":\"duration\",\"type\":\"GreaterThan\",\"value\":\"15\"}]")
  episodeRegex     String   @default("(?<=[E/])(\\d{2})(?=\\))")
  seasonRegex      String   @default("(?<=[S(])(\\d{2})(?=[/E])")
  titleRegexRules  String   @default("[]")
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  @@index([tvdbId])
}

model TopicCategory {
  id       String   @id @default(cuid())
  topic    String   @unique
  category String // "movie" | "tv" | "unknown"
  tmdbId   Int?
  cachedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([topic])
}

// PostgreSQL-only operational state; never imported from the legacy SQLite source.
model MigrationCheckpoint {
  key       String   @id
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}
